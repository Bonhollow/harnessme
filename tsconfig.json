{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noUncheckedIndexedAccess": true,
    "baseUrl": ".",
    "paths": {
      "@harnessme/core": ["packages/core/src/index.ts"],
      "@harnessme/analyzers": ["packages/analyzers/src/index.ts"],
      "@harnessme/renderers": ["packages/renderers/src/index.ts"]
    }
  },
  "include": ["packages/**/*.ts", "tests/**/*.ts", "tsup.config.ts"],
  "exclude": ["dist", "node_modules"]
}
